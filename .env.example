# ── Supabase (Project Settings → API Keys / Data API) ─────────────────────
# Project URL, e.g. https://abcdefghijk.supabase.co
SUPABASE_URL=
# SECRET key (sb_secret_…). Server only — never put it in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: PUBLISHABLE key (sb_publishable_…). Enables instant updates via
# Supabase Realtime. Without it the app still works and refreshes every 3 s.
SUPABASE_PUBLISHABLE_KEY=

# ── Security ───────────────────────────────────────────────────────────────
# Any random string of 32+ characters (e.g. output of: openssl rand -hex 32)
SESSION_SECRET=

# ── Spotify (developer.spotify.com/dashboard → your app → Settings) ────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Apple Music — optional, needs a paid Apple Developer account ──────────
# Team ID (Membership page), Key ID and the full contents of the .p8 file
# of a key with "Media Services (MusicKit)" enabled.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
